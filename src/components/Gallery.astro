---
import Icon from './Icon.astro';
import Picture from './Picture.astro';

const photos = [
  { name: 'fachada-coral', widths: [600, 1000, 1400], alt: 'Fachada del modelo Coral, Residencial Gema', caption: 'Fachada modelo Coral', cls: 'g-tall' },
  { name: 'interior-planta-baja', widths: [800, 1400], alt: 'Planta baja abierta con vista a la cocina y al patio', caption: 'Planta baja abierta', cls: '' },
  { name: 'interior-cocina', widths: [800, 1400], alt: 'Cocina integral con barra y cancel corredizo al jardín', caption: 'Cocina integral', cls: '' },
  { name: 'fachada-coral-ampliada', widths: [600, 900], alt: 'Fachada del modelo Coral Ampliada, Residencial Gema', caption: 'Fachada modelo Coral Ampliada', cls: 'g-tall' },
  { name: 'interior-estancia', widths: [800, 1400], alt: 'Estancia con iluminación natural y salida al patio', caption: 'Estancia luminosa', cls: '' },
  { name: 'interior-cocina-2', widths: [800, 1400], alt: 'Barra desayunadora y cocina con alacena', caption: 'Barra y cocina', cls: '' },
  { name: 'interior-comedor', widths: [800, 1400], alt: 'Área de comedor junto a la cocina integral', caption: 'Comedor y cocina', cls: '' },
];
---

<section id="galeria" class="section gallery" aria-labelledby="galeria-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="stack">
        <p class="eyebrow reveal">05 — Galería</p>
        <h2 id="galeria-title" class="h-section reveal">Espacios que se <em>disfrutan todos los días</em></h2>
      </div>
      <p class="lead reveal">
        Recorre las fachadas y los interiores de la casa muestra: espacios abiertos, acabados claros y luz natural.
      </p>
    </div>

    <div class="gallery-layout">
      <div class="video-card reveal">
        <video
          class="video"
          src="/video/recorrido-gema.mp4"
          poster="/video/recorrido-poster.webp"
          preload="none"
          playsinline
          muted
          loop
          aria-label="Recorrido en video por el interior de una casa de Residencial Gema"
          data-video></video>
        <button class="video-play" type="button" data-video-play>
          <span class="video-play-icon"><Icon name="play" size={26} /></span>
          <span class="video-play-text">Ver recorrido<br /><small>Casa muestra</small></span>
        </button>
      </div>

      <ul class="photo-grid" data-lightbox-group>
        {photos.map((p, i) => (
          <li class={`photo reveal ${p.cls}`} data-delay={String((i % 3) + 1)}>
            <button type="button" class="photo-btn" data-lightbox-src={`/img/${p.name}-${p.widths.at(-1)}.webp`} data-lightbox-alt={p.alt} data-lightbox-caption={p.caption}>
              <Picture name={p.name} widths={p.widths} alt={p.alt} sizes="(min-width: 1000px) 22vw, 46vw" />
              <span class="photo-caption">{p.caption}<Icon name="expand" size={16} /></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <p class="gallery-note">Imágenes ilustrativas. Las fachadas son renders de referencia; acabados y equipamiento pueden variar.</p>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Visor de imágenes">
    <button class="lb-btn lb-close" type="button" data-lb-close><span class="sr-only">Cerrar</span><Icon name="close" size={26} /></button>
    <button class="lb-btn lb-prev" type="button" data-lb-prev><span class="sr-only">Anterior</span><Icon name="chevronL" size={28} /></button>
    <figure>
      <img data-lb-img alt="" />
      <figcaption data-lb-caption></figcaption>
    </figure>
    <button class="lb-btn lb-next" type="button" data-lb-next><span class="sr-only">Siguiente</span><Icon name="chevronR" size={28} /></button>
  </dialog>
</section>

<style>
  .gallery { background: var(--ivory); }
  .stack { display: grid; gap: 18px; }
  .gallery-layout { display: grid; gap: 16px; }
  @media (min-width: 1000px) { .gallery-layout { grid-template-columns: 0.42fr 1fr; align-items: stretch; } }

  .video-card { position: relative; border-radius: var(--radius-l); overflow: hidden; background: var(--navy-900); aspect-ratio: 9 / 14; box-shadow: var(--shadow); }
  @media (min-width: 1000px) { .video-card { aspect-ratio: auto; min-height: 100%; } }
  .video { width: 100%; height: 100%; object-fit: cover; }
  .video-play {
    position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-start; gap: 14px; padding: 26px;
    background: linear-gradient(180deg, transparent 45%, rgba(6, 28, 69, 0.8)); border: 0; color: #fff; text-align: left;
    transition: opacity 0.4s;
  }
  .video-play-icon {
    width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--yellow); color: var(--navy-900);
    box-shadow: 0 0 0 10px rgba(254,196,1,0.25); transition: transform 0.4s var(--ease);
  }
  .video-play:hover .video-play-icon { transform: scale(1.08); }
  .video-play-text { font-family: var(--font-display); font-size: 26px; line-height: 1.05; }
  .video-play-text small { font-family: var(--font-body); font-size: 13px; color: #c3cee3; }
  .video-card.is-playing .video-play { opacity: 0; pointer-events: none; }

  .photo-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 200px; grid-auto-flow: dense; }
  @media (min-width: 760px) { .photo-grid { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 230px; } }
  .photo.g-tall { grid-row: span 2; }
  .photo-btn { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: var(--radius); overflow: hidden; background: var(--sand); }
  .photo-btn :global(picture), .photo-btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .photo-btn:hover :global(img) { transform: scale(1.06); }
  .photo-caption {
    position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; justify-content: space-between; align-items: center;
    padding: 9px 14px; border-radius: 999px; background: rgba(255,255,255,0.92); backdrop-filter: blur(6px);
    font-size: 12.5px; font-weight: 700; color: var(--navy); text-align: left;
    transform: translateY(8px); opacity: 0; transition: transform 0.4s var(--ease), opacity 0.4s;
  }
  .photo-btn:hover .photo-caption, .photo-btn:focus-visible .photo-caption { transform: none; opacity: 1; }
  @media (hover: none) { .photo-caption { transform: none; opacity: 1; } }
  .gallery-note { margin-top: 18px; font-size: 13px; color: var(--muted); }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(6, 18, 44, 0.96); color: #fff;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox figure { margin: 0; display: grid; gap: 14px; justify-items: center; padding: 70px 70px 30px; }
  .lightbox img { max-width: min(92vw, 1100px); max-height: 80dvh; width: auto; border-radius: 12px; object-fit: contain; }
  .lightbox figcaption { font-family: var(--font-display); font-size: 22px; }
  .lb-btn {
    position: absolute; width: 54px; height: 54px; border-radius: 50%; border: 1px solid var(--line-light);
    background: rgba(255,255,255,0.06); color: #fff; display: grid; place-items: center; transition: background 0.3s;
  }
  .lb-btn:hover { background: rgba(255,255,255,0.18); }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox figure { padding: 70px 12px 90px; }
    .lb-prev, .lb-next { top: auto; bottom: 18px; transform: none; }
    .lb-prev { left: calc(50% - 64px); } .lb-next { right: calc(50% - 64px); }
  }
</style>

<script>
  // Video
  const card = document.querySelector<HTMLElement>('.video-card');
  const video = document.querySelector<HTMLVideoElement>('[data-video]');
  const play = document.querySelector<HTMLButtonElement>('[data-video-play]');
  play?.addEventListener('click', () => {
    if (!video || !card) return;
    video.muted = false;
    video.controls = true;
    video.play().catch(() => {});
    card.classList.add('is-playing');
  });

  // Lightbox
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]')];
  const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = dlg?.querySelector<HTMLElement>('[data-lb-caption]');
  let idx = 0;
  const show = (i: number) => {
    idx = (i + items.length) % items.length;
    const it = items[idx];
    if (!img || !cap) return;
    img.src = it.dataset.lightboxSrc!;
    img.alt = it.dataset.lightboxAlt ?? '';
    cap.textContent = it.dataset.lightboxCaption ?? '';
  };
  items.forEach((it, i) => it.addEventListener('click', () => { show(i); dlg?.showModal(); }));
  dlg?.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
  dlg?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>
