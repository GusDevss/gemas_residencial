---
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { models, project, waLink } from '../config/site';

const mxn = (n: number) =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(n);
---

<section id="modelos" class="section section--sand models" aria-labelledby="modelos-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="stack">
        <p class="eyebrow reveal">03 — Modelos</p>
        <h2 id="modelos-title" class="h-section reveal">Dos modelos, <em>un mismo estilo</em></h2>
      </div>
      <p class="lead reveal">
        Elige entre <strong>Coral</strong> y <strong>Coral Ampliada</strong>: casas de dos niveles con fachadas
        contemporáneas, cocina integral y patio posterior para disfrutar al aire libre.
      </p>
    </div>

    <div class="models-grid">
      {models.map((m, i) => (
        <article class="model reveal" data-delay={String(i + 1)} id={`modelo-${m.id}`}>
          <div class="model-media">
            <Picture
              name={m.image}
              widths={m.imageWidths}
              alt={`Fachada del modelo ${m.name} en Residencial Gema, Querétaro`}
              sizes="(min-width: 900px) 40vw, 92vw"
            />
            <span class="model-tag">Modelo</span>
          </div>
          <div class="model-body">
            <div class="model-title">
              <h3 class="h-card">{m.name}</h3>
              <p class="model-price">
                {m.price ? <>Desde <strong>{mxn(m.price)}</strong></> : <>Próximamente desde <strong>{project.priceFromLabel}</strong></>}
              </p>
            </div>
            <p class="model-tagline">{m.tagline}</p>
            <p class="model-desc">{m.description}</p>

            <ul class="model-highlights">
              {m.highlights.map((h) => <li><Icon name="check" size={16} />{h}</li>)}
            </ul>

            <dl class="model-specs">
              {m.specs.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd class={s.value ? '' : 'is-soon'}>{s.value ?? 'Próximamente'}</dd>
                </div>
              ))}
            </dl>

            <div class="model-actions">
              <a class="btn" href={`#cotizador`} data-quote-model={m.id}>
                <Icon name="calc" /> Cotizar {m.name}
              </a>
              <a
                class="link-arrow"
                href={waLink(`Hola, me gustaría recibir la ficha técnica (superficies y distribución) del modelo ${m.name} de Residencial Gema.`)}
                target="_blank"
                rel="noopener"
              >
                Solicitar ficha técnica <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stack { display: grid; gap: 18px; }
  .models .lead strong { color: var(--navy); }
  .models-grid { display: grid; gap: 28px; }
  @media (min-width: 900px) { .models-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }

  .model {
    background: #fff; border-radius: var(--radius-l); overflow: hidden; display: flex; flex-direction: column;
    box-shadow: var(--shadow-s); transition: box-shadow 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .model:hover { box-shadow: var(--shadow-l); transform: translateY(-6px); }
  .model-media { position: relative; aspect-ratio: 5 / 4.6; overflow: hidden; background: var(--sand); }
  .model-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; transition: transform 1.2s var(--ease); }
  .model:hover .model-media :global(img) { transform: scale(1.04); }
  .model-tag {
    position: absolute; left: 20px; top: 20px; background: rgba(255,255,255,0.9); backdrop-filter: blur(6px);
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; padding: 8px 14px; border-radius: 999px; color: var(--navy);
  }
  .model-body { padding: clamp(26px, 3vw, 40px); display: grid; gap: 16px; flex: 1; align-content: start; }
  .model-title { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .model-price { font-size: 14px; color: var(--muted); }
  .model-price strong { font-family: var(--font-display); font-size: 26px; color: var(--navy); font-weight: 600; margin-left: 4px; }
  .model-tagline { font-family: var(--font-display); font-style: italic; font-size: 22px; color: var(--gold-600); line-height: 1.2; }
  .model-desc { color: var(--muted); font-size: 15.5px; }
  .model-highlights { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .model-highlights li {
    display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--navy);
    background: var(--ivory); border: 1px solid var(--line); padding: 7px 12px; border-radius: 999px;
  }
  .model-highlights :global(svg) { color: var(--gold-600); }
  .model-specs { display: grid; grid-template-columns: repeat(2, 1fr); margin: 6px 0 0; border-top: 1px solid var(--line); }
  @media (min-width: 520px) { .model-specs { grid-template-columns: repeat(4, 1fr); } }
  .model-specs > div { padding: 14px 10px 14px 0; border-bottom: 1px solid var(--line); }
  .model-specs dt { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .model-specs dd { margin: 4px 0 0; font-family: var(--font-display); font-size: 24px; color: var(--navy); }
  .model-specs dd.is-soon { font-family: var(--font-body); font-size: 13px; font-weight: 600; color: var(--gold-600); padding-top: 6px; }
  .model-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-top: 8px; }
</style>
